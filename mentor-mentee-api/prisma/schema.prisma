generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
  binaryTargets   = ["native", "linux-musl"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model EmailVerification {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  codeHash     String
  expiresAt    DateTime
  attempts     Int       @default(0)
  lastSentAt   DateTime  @default(now())
  role         user_role
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime

  @@index([email])
  @@index([expiresAt])
}

model PasswordReset {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime @default(now())
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@index([email])
  @@index([expiresAt])
}

model booking {
  id         Int            @id @default(autoincrement())
  scheduleId Int
  menteeId   Int
  status     booking_status @default(PENDING)
  notes      String?
  createdAt  DateTime       @default(now())
  user       user           @relation(fields: [menteeId], references: [id], map: "Booking_menteeId_fkey")
  schedule   schedule       @relation(fields: [scheduleId], references: [id], map: "Booking_scheduleId_fkey")
  session    session?

  @@unique([scheduleId, menteeId], map: "Booking_scheduleId_menteeId_key")
  @@index([menteeId], map: "Booking_menteeId_idx")
}

model feedback {
  id                           Int      @id @default(autoincrement())
  sessionId                    Int      @unique(map: "Feedback_sessionId_key")
  mentorId                     Int
  menteeId                     Int
  rating                       Int
  comment                      String?
  createdAt                    DateTime @default(now())
  user_feedback_menteeIdTouser user     @relation("feedback_menteeIdTouser", fields: [menteeId], references: [id], map: "Feedback_menteeId_fkey")
  user_feedback_mentorIdTouser user     @relation("feedback_mentorIdTouser", fields: [mentorId], references: [id], map: "Feedback_mentorId_fkey")
  session                      session  @relation(fields: [sessionId], references: [id], map: "Feedback_sessionId_fkey")

  @@index([menteeId], map: "Feedback_menteeId_idx")
  @@index([mentorId], map: "Feedback_mentorId_idx")
  @@index([rating], map: "Feedback_rating_idx")
}

model like {
  id        Int      @id @default(autoincrement())
  postId    Int
  userId    Int
  createdAt DateTime @default(now())
  post      post     @relation(fields: [postId], references: [id], onDelete: Cascade, map: "Like_postId_fkey")
  user      user     @relation(fields: [userId], references: [id], map: "Like_userId_fkey")

  @@unique([postId, userId], map: "Like_postId_userId_key")
  @@index([postId], map: "Like_postId_idx")
  @@index([userId], map: "Like_userId_idx")
}

model menteeprofile {
  id          Int                   @id @default(autoincrement())
  userId      Int                   @unique(map: "MenteeProfile_userId_key")
  fullName    String
  avatar      String?               @db.VarChar(500)
  phoneNumber String?               @db.VarChar(20)
  goals       String?
  interests   MenteeTopicInterest[]
  user        user                  @relation(fields: [userId], references: [id], map: "MenteeProfile_userId_fkey")
}

model mentorprofile {
  id          Int                    @id @default(autoincrement())
  userId      Int                    @unique(map: "MentorProfile_userId_key")
  fullName    String
  avatar      String?                @db.VarChar(500)
  phoneNumber String?                @db.VarChar(20)
  school      String?
  degree      String?
  yearsExp    Int?
  bio         String?
  expertise   MentorTopicExpertise[]
  user        user                   @relation(fields: [userId], references: [id], map: "MentorProfile_userId_fkey")

  @@fulltext([fullName], map: "MentorProfile_fullName_idx")
}

model Topic {
  id              Int                    @id @default(autoincrement())
  name            String                 @unique
  description     String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime
  menteeInterests MenteeTopicInterest[]
  mentorExpertise MentorTopicExpertise[]

  @@index([name])
}

model MenteeTopicInterest {
  menteeProfileId Int
  topicId         Int
  createdAt       DateTime      @default(now())
  menteeProfile   menteeprofile @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  topic           Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([menteeProfileId, topicId])
  @@index([menteeProfileId])
  @@index([topicId])
}

model MentorTopicExpertise {
  mentorProfileId Int
  topicId         Int
  createdAt       DateTime      @default(now())
  mentorProfile   mentorprofile @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  topic           Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@id([mentorProfileId, topicId])
  @@index([mentorProfileId])
  @@index([topicId])
}

model notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      user     @relation(fields: [userId], references: [id], map: "Notification_userId_fkey")

  @@index([userId, isRead], map: "Notification_userId_isRead_idx")
}

model post {
  id        Int         @id @default(autoincrement())
  authorId  Int
  title     String
  content   String      @db.Text
  isPublic  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime
  like      like[]
  user      user        @relation(fields: [authorId], references: [id], map: "Post_authorId_fkey")
  images    postimage[]

  @@index([authorId], map: "Post_authorId_idx")
  @@index([createdAt], map: "Post_createdAt_idx")
  @@index([isPublic], map: "Post_isPublic_idx")
}

model postimage {
  id        Int      @id @default(autoincrement())
  postId    Int
  imageUrl  String   @db.VarChar(500)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  post      post     @relation(fields: [postId], references: [id], onDelete: Cascade, map: "PostImage_postId_fkey")

  @@index([postId], map: "PostImage_postId_idx")
}

model schedule {
  id          Int             @id @default(autoincrement())
  mentorId    Int
  topic       String
  description String?         @db.Text
  startAt     DateTime
  endAt       DateTime
  capacity    Int             @default(1)
  status      schedule_status @default(AVAILABLE)
  createdAt   DateTime        @default(now())
  booking     booking[]
  user        user            @relation(fields: [mentorId], references: [id], map: "Schedule_mentorId_fkey")

  @@index([mentorId, startAt], map: "Schedule_mentorId_startAt_idx")
  @@index([status], map: "Schedule_status_idx")
}

model session {
  id                          Int            @id @default(autoincrement())
  bookingId                   Int            @unique(map: "Session_bookingId_key")
  mentorId                    Int
  menteeId                    Int
  startedAt                   DateTime?
  endedAt                     DateTime?
  status                      session_status @default(SCHEDULED)
  notes                       String?
  autoStarted                 Boolean        @default(false)
  autoEnded                   Boolean        @default(false)
  feedback                    feedback?
  booking                     booking        @relation(fields: [bookingId], references: [id], map: "Session_bookingId_fkey")
  user_session_menteeIdTouser user           @relation("session_menteeIdTouser", fields: [menteeId], references: [id], map: "Session_menteeId_fkey")
  user_session_mentorIdTouser user           @relation("session_mentorIdTouser", fields: [mentorId], references: [id], map: "Session_mentorId_fkey")

  @@index([menteeId], map: "Session_menteeId_fkey")
  @@index([mentorId], map: "Session_mentorId_fkey")
  @@index([status], map: "Session_status_idx")
}

model user {
  id                               Int              @id @default(autoincrement())
  email                            String           @unique(map: "User_email_key")
  password                         String
  role                             user_role        @default(MENTEE)
  roleId                           Int?
  createdAt                        DateTime         @default(now())
  updatedAt                        DateTime
  userPermissions                  UserPermission[]
  booking                          booking[]
  feedback_feedback_menteeIdTouser feedback[]       @relation("feedback_menteeIdTouser")
  feedback_feedback_mentorIdTouser feedback[]       @relation("feedback_mentorIdTouser")
  like                             like[]
  menteeprofile                    menteeprofile?
  mentorprofile                    mentorprofile?
  notification                     notification[]
  post                             post[]
  schedule                         schedule[]
  session_session_menteeIdTouser   session[]        @relation("session_menteeIdTouser")
  session_session_mentorIdTouser   session[]        @relation("session_mentorIdTouser")
  roleRelation                     Role?            @relation(fields: [roleId], references: [id])

  @@index([role], map: "User_role_idx")
  @@index([roleId], map: "User_roleId_idx")
}

model Role {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  rolePermissions RolePermission[]
  users           user[]
}

model Permission {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  resource        String
  action          String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([resource])
  @@index([action])
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserPermission {
  userId       Int
  permissionId Int
  isGranted    Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  user         user       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@index([userId])
  @@index([permissionId])
}

enum session_status {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum user_role {
  ADMIN
  MENTOR
  MENTEE
}

enum booking_status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum schedule_status {
  AVAILABLE
  BOOKED
  CANCELLED
}
