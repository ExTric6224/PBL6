              "raw": "{\n  \"fullName\": \"John Doe\",\n  \"school\": \"MIT\",\n  \"expertise\": [\"Backend\", \"Mobile\", \"DevOps\"],\n  \"degree\": \"Master of Computer Science\",\n  \"yearsExp\": 5,\n  \"bio\": \"Experienced software engineer with expertise in backend development.\"\n}"
            },
            "url": {
