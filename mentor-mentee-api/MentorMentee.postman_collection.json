        {
          "name": "Get Mentor Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/profiles/mentor/2",
              "host": ["{{baseUrl}}"],
              "path": ["profiles", "mentor", "2"]
            }
          }
        },
        {
          "name": "Create/Update Mentee Profile",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Jane Smith\",\n  \"goals\": \"Learn backend development and best practices\",\n  \"interests\": [\"Web\", \"AI\", \"Career\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profiles/mentee",
              "host": ["{{baseUrl}}"],
              "path": ["profiles", "mentee"]
            }
          }
        },
        {
          "name": "Get Mentee Profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/profiles/mentee/3",
              "host": ["{{baseUrl}}"],
              "path": ["profiles", "mentee", "3"]
            }
          }
        }
      ]
    },
    {
      "name": "Schedules",
      "item": [
        {
          "name": "Create Schedule",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Backend Development Fundamentals\",\n  \"startAt\": \"2024-12-01T14:00:00.000Z\",\n  \"endAt\": \"2024-12-01T15:00:00.000Z\",\n  \"capacity\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/schedules",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"]
            }
          }
        },
        {
          "name": "Get Schedules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedules?status=AVAILABLE",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"],
              "query": [
                {
                  "key": "status",
                  "value": "AVAILABLE"
                }
              ]
            }
          }
        },
        {
          "name": "Update Schedule",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"topic\": \"Advanced Backend Concepts\",\n  \"capacity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/schedules/1",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "1"]
            }
          }
        },
        {
          "name": "Delete Schedule",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedules/1",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "1"]
            }
          }
        },
        {
          "name": "Get My Schedules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedules/my-schedules?status=AVAILABLE&from=2024-12-01&to=2024-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "my-schedules"],
              "query": [
                {
                  "key": "status",
                  "value": "AVAILABLE",
                  "description": "Filter by schedule status (AVAILABLE, FULL, CANCELLED)"
                },
                {
                  "key": "from",
                  "value": "2024-12-01",
                  "description": "Filter schedules from this date (YYYY-MM-DD)"
                },
                {
                  "key": "to",
                  "value": "2024-12-31",
                  "description": "Filter schedules to this date (YYYY-MM-DD)"
                }
              ]
            }
          }
        },
        {
          "name": "Get Schedule by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedules/1",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "1"]
            }
          }
        },
        {
          "name": "Get Schedules by Mentor ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/schedules?mentorId=2&status=AVAILABLE&from=2024-12-01&to=2024-12-31",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"],
              "query": [
                {
                  "key": "mentorId",
                  "value": "2",
                  "description": "Filter by mentor ID"
                },
                {
                  "key": "status",
                  "value": "AVAILABLE",
                  "description": "Filter by schedule status (AVAILABLE, FULL, CANCELLED)"
                },
                {
                  "key": "from",
                  "value": "2024-12-01",
                  "description": "Filter schedules from this date (YYYY-MM-DD)"
                },
                {
                  "key": "to",
                  "value": "2024-12-31",
                  "description": "Filter schedules to this date (YYYY-MM-DD)"
                }
              ]
            }
          }
        }
      ]
    },
