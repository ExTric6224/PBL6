    {
      "name": "9. Get Schedules (Verify Mentor Topics)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Schedules include mentor expertise', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.length > 0) {",
              "        var schedule = jsonData.data[0];",
              "        if (schedule.mentor && schedule.mentor.mentorProfile) {",
              "            pm.expect(schedule.mentor.mentorProfile.expertise).to.be.an('array');",
              "            console.log('Mentor expertise in schedule:', ",
              "                schedule.mentor.mentorProfile.expertise.map(t => t.name));",
              "        }",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{mentor_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/schedules",
          "host": ["{{base_url}}"],
          "path": ["api", "schedules"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
