    {
      "name": "8. Get Mentee Profile",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Interests topics are returned', function () {",
              "    var jsonData = pm.response.json();",
              "    var topicNames = jsonData.data.interests.map(t => t.name);",
              "    pm.expect(topicNames).to.include('Web Development');",
