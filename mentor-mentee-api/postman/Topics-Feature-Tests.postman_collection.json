    {
      "name": "7. Create/Update Mentee Profile with Interests",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Interests is array of topic objects', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.interests).to.be.an('array');",
              "    pm.expect(jsonData.data.interests.length).to.equal(3);",
              "});",
              "",
              "console.log('Mentee profile created:');",
              "var profile = pm.response.json().data;",
              "console.log('  Name:', profile.fullName);",
              "console.log('  Goals:', profile.goals);",
              "console.log('  Interests:');",
              "profile.interests.forEach(function(topic) {",
              "    console.log('    -', topic.name);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
