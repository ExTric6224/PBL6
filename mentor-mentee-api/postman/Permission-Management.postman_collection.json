{
	"info": {
		"name": "Permission Management API",
		"description": "Collection để test chức năng trao quyền/cấp quyền cho user",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{admin_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "test_user_id",
			"value": "5",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "0. Authentication",
			"item": [
				{
					"name": "Login as ADMIN",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.token) {",
									"        pm.collectionVariables.set('admin_token', jsonData.data.token);",
									"        console.log('Admin token saved:', jsonData.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Đăng nhập với tài khoản ADMIN để lấy token. Token sẽ tự động được lưu vào biến collection."
					},
					"response": []
				}
			]
		},
		{
			"name": "1. View Permissions & Roles",
			"item": [
				{
					"name": "List All Permissions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/permissions",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions"]
						},
						"description": "Xem tất cả các quyền có sẵn trong hệ thống, được nhóm theo resource (schedule, booking, post, ...)"
					},
					"response": []
				},
				{
					"name": "List All Roles",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/roles",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "roles"]
						},
						"description": "Xem tất cả các roles (ADMIN, MENTOR, MENTEE) và quyền mặc định của từng role"
					},
					"response": []
				},
				{
					"name": "Get Permissions for Role (MENTEE)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/roles/MENTEE",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "roles", "MENTEE"]
						},
						"description": "Xem chi tiết quyền của role MENTEE"
					},
					"response": []
				},
				{
					"name": "Get Permissions for Role (MENTOR)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/roles/MENTOR",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "roles", "MENTOR"]
						},
						"description": "Xem chi tiết quyền của role MENTOR"
					},
					"response": []
				},
				{
					"name": "Get Permissions for Role (ADMIN)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/roles/ADMIN",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "roles", "ADMIN"]
						},
						"description": "Xem chi tiết quyền của role ADMIN"
					},
					"response": []
				}
			]
		},
		{
			"name": "2. User Permission Management",
			"item": [
				{
					"name": "Get User Permissions",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/users/{{test_user_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "users", "{{test_user_id}}"]
						},
						"description": "Xem quyền hiệu lực của user (bao gồm cả override). Thay đổi test_user_id trong biến collection."
					},
					"response": []
				},
				{
					"name": "Grant Permission to User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"permissionCode\": \"post:create\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/users/{{test_user_id}}/grant",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "users", "{{test_user_id}}", "grant"]
						},
						"description": "Cấp một quyền đặc biệt cho user (override). Ví dụ: cấp quyền tạo post cho một MENTEE."
					},
					"response": []
				},
				{
					"name": "Revoke Permission from User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"permissionCode\": \"schedule:create\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/users/{{test_user_id}}/revoke",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "users", "{{test_user_id}}", "revoke"]
						},
						"description": "Thu hồi một quyền từ user (override - deny). Ví dụ: cấm một MENTOR tạo schedule."
					},
					"response": []
				},
				{
					"name": "Remove User Permission Override",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/users/{{test_user_id}}/post:create",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "users", "{{test_user_id}}", "post:create"]
						},
						"description": "Xóa override, user sẽ quay về quyền mặc định của role. Thay 'post:create' bằng permission code bạn muốn xóa."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Role Permission Management",
			"item": [
				{
					"name": "Add Permission to Role",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"permissionCode\": \"profile:view_any\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/roles/MENTEE/add",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "roles", "MENTEE", "add"]
						},
						"description": "Thêm một quyền mới vào role. Ví dụ: cho phép MENTEE xem profile của người khác."
					},
					"response": []
				},
				{
					"name": "Remove Permission from Role",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"permissionCode\": \"post:like\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/roles/MENTEE/remove",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "roles", "MENTEE", "remove"]
						},
						"description": "Xóa một quyền khỏi role. Ví dụ: ngăn MENTEE like bài post."
					},
					"response": []
				},
				{
					"name": "Replace All Role Permissions",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"permissionCodes\": [\n    \"booking:create\",\n    \"booking:view_own\",\n    \"schedule:view_any\",\n    \"post:view_any\",\n    \"post:view_own\",\n    \"post:like\"\n  ]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/admin/permissions/roles/MENTEE",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "permissions", "roles", "MENTEE"]
						},
						"description": "⚠️ NGUY HIỂM: Thay thế TOÀN BỘ quyền của role. Tất cả quyền cũ sẽ bị xóa!"
					},
					"response": []
				}
			]
		},
